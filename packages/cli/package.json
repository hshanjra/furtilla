{
  "name": "@furtilla/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "furtilla": "./dist/index.js"
  },
